# Binance testnet — get keys at https://testnet.binance.vision/
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Trading config
TICKER=BTCUSDT
SIGNAL_CONFIDENCE_THRESHOLD=0.65
MAX_ORDER_USDT=100

# Risk management
MAX_OPEN_USDT=300
STOP_LOSS_PCT=2.5
TAKE_PROFIT_PCT=4
ADAPTIVE_THRESHOLD=true
TREND_FILTER=true

# Machine learning gate
ML_GATE=true
ML_MIN_PROB=0.35



# Alerts (optional)
# SLACK_WEBHOOK_URL=
# ALERT_EMAIL=
# SENDGRID_API_KEY=
# FROM_EMAIL=

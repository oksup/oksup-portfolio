# Copy this file to .env and fill in real values. Never commit .env.

# Discord bot token, from the Developer Portal (Bot tab -> Reset Token)
DISCORD_TOKEN=

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which provider config.py loads: gemini | anthropic
LLM_PROVIDER=gemini

# Leave this alone for now.
# Unset means the bot uses Gemini Flash, which has the most generous free
# allowance. That is plenty for the simple tools in this project.
#
# If the bot starts picking the wrong tool a lot, uncomment the next line to
# switch to the stronger model. It is still free, but with a much smaller
# daily allowance, so you may hit a limit sooner.
# FORCE_ROLE=smart

# Only needed if you ever set LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- #code channel ---------------------------------------------------------
# The one folder the coding agent is allowed to touch.
PROJECT_REPO=~/dev/style-report

# How to run your coding agent. Run `python check_agent.py` and it will print
# the exact line to paste here.
CODING_AGENT_CMD=

# --- #payments channel -----------------------------------------------------
# QRIS with manual confirmation. No payment gateway, no fees at this ticket
# size: Bank Indonesia sets MDR at 0% for micro merchants on Rp 500.000
# or less.
PRODUCT_PRICE_IDR=39000

# --- email delivery (Brevo) ------------------------------------------------
# PERSONAL Brevo account. Never the Nakula one.
# Key: Brevo dashboard -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=
# The from address. Must be a verified sender in Brevo.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Style Report

# --- cost log --------------------------------------------------------------
# Set to 0 to stop writing data/costs.csv. On by default; it is a few bytes
# per call and it is how you notice a runaway loop.
COST_LOG_ENABLED=1
